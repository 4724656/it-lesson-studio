{
  "name": "it-lesson-studio",
  "version": "1.0.0",
  "description": "中小学信息科技四位一体教学工坊：教案（Word）、课件（Marp PPT/PDF）、导学单（Word）与互动课堂作业（HTML）",
  "license": "MIT",
  "type": "module",
  "files": [
    "skills",
    "resources",
    "scripts",
    "references"
  ],
  "scripts": {
    "export:lesson": "node scripts/export-lesson.mjs",
    "check:lesson": "uv run python scripts/check_lesson.py",
    "test": "node --test scripts/export-lesson.test.mjs",
    "web:start": "node web/server.js",
    "web:dev": "node --watch web/server.js"
  },
  "keywords": [
    "information-technology",
    "lesson-planning",
    "marp",
    "pandoc",
    "interactive-classwork",
    "k12-education"
  ],
  "dependencies": {
    "@marp-team/marp-cli": "^4.5.1"
  },
  "engines": {
    "node": ">=20"
  }
}
