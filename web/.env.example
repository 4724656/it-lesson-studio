# ==========================================
# IT Lesson Studio Web 服务配置
# ==========================================

# 服务监听端口
PORT=3800

# 教研组专属注册邀请码（组内老师注册时填此码）
INVITE_CODE=ZJ2026

# JWT 鉴权密钥（可选：默认每台部署首次启动自动生成 256 位强随机密钥并持久化至 SQLite，各部署实例独立且容器重启不失效；若多实例集群部署需共享登录状态，可取消注释并指定固定密钥）
# JWT_SECRET=your-custom-production-secret-here

# 大模型 API 配置（OpenAI 兼容端点，如 OpenAI / DeepSeek / 硅基流动等）
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=sk-your-key-here
AI_MODEL=gpt-4o-mini

# P1 实验性生成诊断与完整性拦截（默认关闭；设为 1 开启，0 恢复 V1）
# 不改变提示词或调用次数；检查器失败只记录，不自动修复或重试
AI_GENERATION_DIAGNOSTICS=0

# 实验性 HTML V2：教学差异 JSON + 本地公共引擎；默认 v1，不自动切换或重试
AI_HTML_GENERATOR=v1
