node_modules/
.vscode/
*.tmp.md
*.tmp.*
~$*.docx
~$*.pptx
.DS_Store
Thumbs.db
__pycache__/
.venv/

# 编译产物一律不跟踪（可通过 npm run export:lesson 从 .md 源码 100% 重建）
*.docx
*.pptx
*.pdf
# 学生导出的学习凭单（HTML 一键下载的 班级_姓名_课题_得分.txt）一律不跟踪
*_*.txt

# 本地教师专用下载/抓取辅助脚本（仅限个人教学合理使用，不公开跟踪与推送）
scripts/download_*.py

# 教师个人备课产物输出目录（运行 export-lesson.mjs --output-dir output/ 时生成）
output/
# 教师个人工作区（在 repo 内备课时使用，内容不纳入版本库）
workspace/
# 本地教材与课件原始资料下载目录（含版权保护教学材料，严禁提交与公开推送）
downloads/

# Web 服务本地运行时数据与密钥（杜绝任何本地环境配置文件泄漏）
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example
web/data/
web/node_modules/

